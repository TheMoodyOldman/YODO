# Copy to .env and fill in
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./app.db

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
# https://www.themoviedb.org/settings/api (API key or read access token)
TMDB_API_KEY=
# Optional; Google Books works without a key at low volume
GOOGLE_BOOKS_API_KEY=

# Usernames allowed to review reports at /admin/reports (comma-separated)
ADMIN_USERNAMES=

# Email verification and password resets (optional; verification is enforced only when set)
# Gmail: turn on 2-step verification, create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Public address for links in emails, e.g. https://xxxx.trycloudflare.com (optional)
PUBLIC_URL=

# Optional Google bookshelf OAuth (operator configures once; users need no API keys)
# Enable Books API and create a Web application OAuth client in Google Cloud Console.
GOOGLE_BOOKS_CLIENT_ID=
GOOGLE_BOOKS_CLIENT_SECRET=
# Must exactly match the registered callback; HTTPS except local development.
# e.g. https://yodo.example.com/me/google-books/callback
GOOGLE_BOOKS_REDIRECT_URI=
